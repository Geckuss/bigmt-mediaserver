{
  "modno": 22,
  "version": 6,
  "instance": "bigmt-backrest",
  "repos": [
    {
      "id": "primary-5tb",
      "uri": "/repos/primary",
      "guid": "83f51921b63ba76de8fb8cec29927f6dff90f1929bbdbd256c7ba33994e529d2",
      "password": "<RESTIC_REPO_PASSWORD>",
      "prunePolicy": {
        "schedule": {
          "disabled": true,
          "clock": "CLOCK_LAST_RUN_TIME"
        },
        "maxUnusedPercent": 10
      },
      "checkPolicy": {
        "schedule": {
          "disabled": true,
          "clock": "CLOCK_LAST_RUN_TIME"
        }
      },
      "hooks": [
        {
          "conditions": [
            "CONDITION_ANY_ERROR",
            "CONDITION_SNAPSHOT_SUCCESS",
            "CONDITION_CHECK_SUCCESS",
            "CONDITION_FORGET_SUCCESS",
            "CONDITION_PRUNE_SUCCESS"
          ],
          "actionDiscord": {
            "webhookUrl": "<DISCORD_WEBHOOK_URL>",
            "template": "**{{ if .Plan.Id }}{{ .Plan.Id }}{{ else }}{{ if .Repo }}{{ .Repo.Id }}{{ end }}{{ end }}** — {{ .EventName .Event }}\n{{- if .Error }}\n```\n{{ .Error }}\n```\n{{- end }}\n{{- if .SnapshotStats }}\n{{ if .SnapshotStats.DataAdded }}Added **{{ .FormatSizeBytes .SnapshotStats.DataAdded }}** · {{ else }}No new data · {{ end }}{{ .SnapshotStats.TotalFilesProcessed }} files · {{ .FormatDuration .Duration }}\n{{- end }}"
          }
        }
      ],
      "commandPrefix": {}
    },
    {
      "id": "secondary-1tb",
      "uri": "/repos/secondary",
      "password": "<RESTIC_REPO_PASSWORD>",
      "autoInitialize": true,
      "autoUnlock": true,
      "prunePolicy": {
        "schedule": {
          "disabled": true,
          "clock": "CLOCK_LAST_RUN_TIME"
        },
        "maxUnusedPercent": 10
      },
      "checkPolicy": {
        "schedule": {
          "disabled": true,
          "clock": "CLOCK_LAST_RUN_TIME"
        }
      },
      "commandPrefix": {}
    },
    {
      "id": "tertiary-1tb",
      "uri": "/repos/tertiary",
      "password": "<RESTIC_REPO_PASSWORD>",
      "autoInitialize": true,
      "autoUnlock": true,
      "prunePolicy": {
        "schedule": {
          "disabled": true,
          "clock": "CLOCK_LAST_RUN_TIME"
        },
        "maxUnusedPercent": 10
      },
      "checkPolicy": {
        "schedule": {
          "disabled": true,
          "clock": "CLOCK_LAST_RUN_TIME"
        }
      },
      "commandPrefix": {}
    }
  ],
  "plans": [
    {
      "id": "critical",
      "repo": "primary-5tb",
      "paths": [
        "/userdata/configs",
        "/userdata/immich-uploads"
      ],
      "excludes": [
        "/userdata/configs/jellyfin-config/data/introskipper"
      ],
      "schedule": {
        "disabled": true,
        "clock": "CLOCK_LOCAL"
      },
      "retention": {
        "policyKeepLastN": 5
      }
    },
    {
      "id": "critical-secondary",
      "repo": "secondary-1tb",
      "paths": [
        "/userdata/configs",
        "/userdata/immich-uploads"
      ],
      "excludes": [
        "/userdata/configs/jellyfin-config/data/introskipper"
      ],
      "schedule": {
        "disabled": true,
        "clock": "CLOCK_LOCAL"
      },
      "retention": {
        "policyKeepLastN": 5
      }
    },
    {
      "id": "critical-tertiary",
      "repo": "tertiary-1tb",
      "paths": [
        "/userdata/configs",
        "/userdata/immich-uploads"
      ],
      "excludes": [
        "/userdata/configs/jellyfin-config/data/introskipper"
      ],
      "schedule": {
        "disabled": true,
        "clock": "CLOCK_LOCAL"
      },
      "retention": {
        "policyKeepLastN": 5
      }
    },
    {
      "id": "media",
