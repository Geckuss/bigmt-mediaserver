# This file documents every variable NAME the stacks reference.
# It must never contain real values. This repo is public.
# Real values live on the host in ${CONFIGS}/secrets/<stack>.env, chmod 600.

# System
PUID=1000
PGID=1000
TZ=Europe/Helsinki

# Paths
DATA=/path/to/data
CONFIGS=/path/to/configs
UPLOAD_LOCATION=/path/to/immich/uploads

# Jellyfin
JELLYFIN_URL=https://jellyfin.example.com

# *arr / downloads (mediastack)
RADARR_PORT=7878
SONARR_PORT=8989
BAZARR_PORT=6767
PROWLARR_PORT=9696
QBITTORRENT_WEBUI=8080
QBITTORRENT_PEER_TCP=6881
QBITTORRENT_PEER_UDP=6881
HANDBRAKE_WEBUI=5800

# Pi-hole
# PIHOLE_PASSWORD is deliberately NOT set here, and does not belong in git.
#
# It is a BOOTSTRAP value only. pihole v6 hashes WEBPASSWORD into
# ${CONFIGS}/pihole/etc-pihole/pihole.toml as `pwhash` on first start, and
# ignores the environment variable on every start after that. The live
# password is therefore that hash, not anything in this file.
#
# It is still wired up, as the Komodo secret variable PIHOLE_PASSWORD and
# referenced from the infrastructure stack environment, so that rebuilding
# pihole from scratch cannot come up with no admin password at all on the LAN.
#
# The same password is also the Homepage Pi-hole widget key, kept in clear at
# ${CONFIGS}/homepage-config/services.yaml.
PIHOLE_WEBUI=8089

# Immich
DB_DATA_LOCATION=/path/to/immich/db
DB_PASSWORD=changeme
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
IMMICH_VERSION=release

# Scrutiny
SCRUTINY_PORT=8079

# Backrest
BACKREST_PORT=9898

# Uptime Kuma
UPTIME_KUMA_PORT=3001

# Seafile
SEAFILE_PORT=8082
SEAFILE_MYSQL_ROOT_PASSWORD=changeme
SEAFILE_ADMIN_EMAIL=admin@example.com
SEAFILE_ADMIN_PASSWORD=changeme
SEAFILE_HOSTNAME=seafile.example.com

# Homepage
HOMEPAGE_PORT=3000
HOMEPAGE_ALLOWED_HOSTS=bigmt.example.com,homepage.example.com

# V Rising (modded, image built locally -- see configs/vrising/Dockerfile)
VRISING_SERVERNAME=Manala-Modded
VRISING_WORLDNAME=world1
VRISING_GAME_PORT=9878
VRISING_QUERY_PORT=9879

# Valheim (BepInEx)
VALHEIM_SERVER_NAME=example
VALHEIM_WORLD_NAME=example
VALHEIM_SERVER_PASS=changeme
VALHEIM_ADMINLIST_IDS=
VALHEIM_GAME_PORT=2456
VALHEIM_QUERY_PORT=2457

# Komodo
# Komodo's own stack is NOT managed by Komodo; it is deployed by hand so that
# the state store exists before anything can be managed:
#   cd ${CONFIGS}/komodo && docker compose -p komodo -f compose.yml up -d
# Its real secrets (db credentials, jwt + webhook secrets, admin password)
# are generated on the host into ${CONFIGS}/komodo/core.config.toml, root-only,
# and covered by Backrest. Never committed.
KOMODO_CONFIGS=/path/to/configs/komodo
KOMODO_PORT=9120
KOMODO_HOST=https://komodo.example.com
KOMODO_TITLE=Komodo
