pihole.example.com {
    import security_headers
    # Deliberately NOT using the private_only snippet here: this one needs the
    # gate inside a handle block, because the redirect to /admin has to be
    # skipped for rejected requests too. Same 100.64.0.0/10 + WAN-IP test.
    @not_private not remote_ip 100.64.0.0/10 86.50.78.255/32
    handle @not_private {
        respond "Forbidden" 403
    }
    handle {
        redir / /admin permanent
        reverse_proxy http://<TAILSCALE_HOSTNAME>:80
    }
}
