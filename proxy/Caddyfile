# SANITIZED TEMPLATE. The live copy of this file is on oci at /etc/.../Caddyfile
# and has the real hostnames and the real home WAN address in the (private_only)
# snippet below. Edit here, then copy across. See agents.md.
{
    email your-email@example.com
}

(security_headers) {
    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        Content-Security-Policy "default-src 'self' https:; script-src 'self' 'unsafe-inline' 'unsafe-eval' https:; style-src 'self' 'unsafe-inline' https:; img-src 'self' data: blob: https:; font-src 'self' data: https:; connect-src 'self' wss: https:; media-src 'self' blob: https:; object-src 'none'; frame-ancestors 'self'"
        -Server
        -X-Powered-By
    }
}

(private_only) {
    @not_private not remote_ip 100.64.0.0/10 86.50.78.255/32
    route @not_private {
        respond "Forbidden" 403
    }
}

