# Pterodactyl panel. Not proxied to bigmt: the panel and PHP-FPM run on oci
# itself, and the game server it manages lives on a different tailnet node
# (<PTERODACTYL_TAILSCALE_HOSTNAME>), hence the tls_server_name override.
pterodactyl.example.com {
    @wings path /api/servers /api/servers/* /api/system /api/system/* /api/transfers /api/transfers/* /api/update /api/update/* /upload/* /download/*
    handle @wings {
        reverse_proxy localhost:8080
    }

    handle {
        root * /var/www/pterodactyl/public
        php_fastcgi unix//run/php/php8.3-fpm.sock
        file_server
    }
}
pterodactyl.example.com:8443 {
    reverse_proxy https://<PTERODACTYL_TAILSCALE_HOSTNAME>:8080 {
        transport http {
            tls_server_name <PTERODACTYL_TAILSCALE_HOSTNAME>
        }
    }
}
:80 {
    respond "Not Found" 404
}
